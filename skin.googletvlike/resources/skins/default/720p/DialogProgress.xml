<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="101">
  <!-- Progress Dialog - For operations like scanning, loading, etc. -->
  
  <backgroundcolor>background_dark</backgroundcolor>
  
  <!-- Semi-transparent overlay -->
  <control type="image">
    <posx>0</posx>
    <posy>0</posy>
    <width>1280</width>
    <height>720</height>
    <texture colordiffuse="overlay_dark">-</texture>
  </control>
  
  <!-- Dialog Container -->
  <control type="group">
    <posx>280</posx>
    <posy>300</posy>
    <width>720</width>
    <height>120</height>
    
    <!-- Background -->
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>720</width>
      <height>120</height>
      <texture colordiffuse="surface">-</texture>
      <bordertexture border="15">-</bordertexture>
    </control>
    
    <!-- Title -->
    <control type="label" id="1">
      <posx>30</posx>
      <posy>12</posy>
      <width>660</width>
      <height>30</height>
      <font>TitleMedium</font>
      <textcolor>text_primary</textcolor>
      <label></label>
    </control>
    
    <!-- Progress Bar -->
    <control type="progress" id="20">
      <posx>30</posx>
      <posy>50</posy>
      <width>660</width>
      <height>5</height>
      <texturebg colordiffuse="surface_variant">-</texturebg>
      <textureleft colordiffuse="primary_blue">-</textureleft>
      <texturemid colordiffuse="primary_blue">-</texturemid>
      <textureright colordiffuse="primary_blue">-</textureright>
    </control>
    
    <!-- Progress Text -->
    <control type="label" id="30">
      <posx>30</posx>
      <posy>65</posy>
      <width>660</width>
      <height>40</height>
      <font>BodySmall</font>
      <textcolor>text_secondary</textcolor>
      <label></label>
      <wrapmultiline>true</wrapmultiline>
    </control>
  </control>
</window>
