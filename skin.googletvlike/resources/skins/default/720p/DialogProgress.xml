<?xml version="1.0" encoding="UTF-8"?>
<!-- GoogleTV Like Skin - Progress Dialog (1280x720) -->
<window id="101">
  <defaultcontrol always="true">1</defaultcontrol>
  <allowoverlay>yes</allowoverlay>

  <!-- Overlay Background -->
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1280</width>
    <height>720</height>
    <texture>$VAR[color_overlay_dark]</texture>
  </control>

  <!-- Dialog Container -->
  <control type="group">
    <left>320</left>
    <top>260</top>
    <width>640</width>
    <height>200</height>

    <!-- Dialog Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>640</width>
      <height>200</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>2</bordersize>
      <bordercolor>$VAR[color_primary]</bordercolor>
    </control>

    <!-- Title -->
    <control type="label" id="1">
      <left>20</left>
      <top>15</top>
      <width>600</width>
      <height>40</height>
      <font>HeadlineMedium</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>Loading...</label>
    </control>

    <!-- Progress Bar -->
    <control type="progress" id="3">
      <left>20</left>
      <top>65</top>
      <width>600</width>
      <height>20</height>
      <texturebg>$VAR[color_surface_variant]</texturebg>
      <lefttexture>$VAR[color_primary]</lefttexture>
      <midtexture>$VAR[color_primary]</midtexture>
      <righttexture>$VAR[color_primary]</righttexture>
    </control>

    <!-- Description -->
    <control type="label">
      <left>20</left>
      <top>95</top>
      <width>600</width>
      <height>80</height>
      <font>LabelSmall</font>
      <textcolor>$VAR[color_text_secondary]</textcolor>
    </control>
  </control>
</window>