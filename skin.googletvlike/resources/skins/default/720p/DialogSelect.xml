<?xml version="1.0" encoding="UTF-8"?>
<!-- GoogleTV Like Skin - Select Dialog (1280x720) -->
<window id="3">
  <defaultcontrol always="true">3</defaultcontrol>
  <allowoverlay>yes</allowoverlay>

  <!-- Overlay Background -->
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1280</width>
    <height>720</height>
    <texture>$VAR[color_overlay_dark]</texture>
  </control>

  <!-- Dialog Container -->
  <control type="group">
    <left>240</left>
    <top>120</top>
    <width>800</width>
    <height>480</height>

    <!-- Dialog Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>800</width>
      <height>480</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>2</bordersize>
      <bordercolor>$VAR[color_primary]</bordercolor>
    </control>

    <!-- Title -->
    <control type="label" id="1">
      <left>20</left>
      <top>15</top>
      <width>760</width>
      <height>40</height>
      <font>HeadlineMedium</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
    </control>

    <!-- List Control -->
    <control type="list" id="3">
      <left>20</left>
      <top>65</top>
      <width>760</width>
      <height>350</height>
      <onleft>610</onleft>
      <onright>610</onright>
      <onup>3</onup>
      <ondown>3</ondown>
      <itemlayout height="40">
        <control type="label">
          <left>15</left>
          <top>0</top>
          <width>730</width>
          <height>40</height>
          <font>BodyMedium</font>
          <textcolor>$VAR[color_text_primary]</textcolor>
          <selectedcolor>$VAR[color_primary]</selectedcolor>
          <info>ListItem.Label</info>
        </control>
      </itemlayout>
      <focusedlayout height="40">
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>760</width>
          <height>40</height>
          <texture>$VAR[color_primary]</texture>
        </control>
        <control type="label">
          <left>15</left>
          <top>0</top>
          <width>730</width>
          <height>40</height>
          <font>BodyMedium</font>
          <textcolor>$VAR[color_text_primary]</textcolor>
          <info>ListItem.Label</info>
        </control>
      </focusedlayout>
    </control>

    <!-- Buttons -->
    <control type="button" id="10">
      <left>20</left>
      <top>425</top>
      <width>365</width>
      <height>35</height>
      <label>OK</label>
      <font>LabelLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <focusedcolor>$VAR[color_primary]</focusedcolor>
      <onclick>Dialog.Close(select)</onclick>
    </control>

    <control type="button" id="11">
      <left>415</left>
      <top>425</top>
      <width>365</width>
      <height>35</height>
      <label>Cancel</label>
      <font>LabelLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <focusedcolor>$VAR[color_primary]</focusedcolor>
      <onclick>Dialog.Close(select)</onclick>
    </control>
  </control>
</window>