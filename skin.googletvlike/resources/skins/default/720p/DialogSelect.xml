<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="3">
  <!-- Select Dialog - For displaying lists of selectable items -->
  
  <backgroundcolor>background_dark</backgroundcolor>
  
  <!-- Semi-transparent overlay -->
  <control type="image">
    <posx>0</posx>
    <posy>0</posy>
    <width>1280</width>
    <height>720</height>
    <texture colordiffuse="overlay_dark">-</texture>
  </control>
  
  <!-- Dialog Container -->
  <control type="group">
    <posx>180</posx>
    <posy>80</posy>
    <width>920</width>
    <height>560</height>
    
    <!-- Background -->
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>920</width>
      <height>560</height>
      <texture colordiffuse="surface">-</texture>
      <bordertexture border="15">-</bordertexture>
    </control>
    
    <!-- Header -->
    <control type="group" id="100">
      <posx>30</posx>
      <posy>15</posy>
      <width>860</width>
      <height>40</height>
      
      <!-- Title -->
      <control type="label" id="1">
        <posx>0</posx>
        <posy>0</posy>
        <width>860</width>
        <height>40</height>
        <font>TitleMedium</font>
        <textcolor>text_primary</textcolor>
        <label>Select an option</label>
      </control>
    </control>
    
    <!-- Divider -->
    <control type="image">
      <posx>30</posx>
      <posy>60</posy>
      <width>860</width>
      <height>1</height>
      <texture colordiffuse="surface_variant">-</texture>
    </control>
    
    <!-- List Container -->
    <control type="list" id="3">
      <posx>30</posx>
      <posy>70</posy>
      <width>860</width>
      <height>400</height>
      <pagecontrol>13</pagecontrol>
      <itemlayout height="60" width="860">
        <!-- List Item Background -->
        <control type="image">
          <posx>0</posx>
          <posy>0</posy>
          <width>860</width>
          <height>60</height>
          <texture colordiffuse="background_dark">-</texture>
        </control>
        
        <!-- List Item Text -->
        <control type="label">
          <posx>15</posx>
          <posy>10</posy>
          <width>830</width>
          <height>40</height>
          <font>BodyMedium</font>
          <textcolor>text_primary</textcolor>
          <selectedcolor>primary_blue</selectedcolor>
          <label>$LISTITEM</label>
        </control>
      </itemlayout>
      
      <focusedlayout height="60" width="860">
        <!-- Focused Item Background -->
        <control type="image">
          <posx>0</posx>
          <posy>0</posy>
          <width>860</width>
          <height>60</height>
          <texture colordiffuse="surface_variant">-</texture>
          <bordertexture border="1" colordiffuse="primary_blue">-</bordertexture>
        </control>
        
        <!-- Focused Item Text -->
        <control type="label">
          <posx>15</posx>
          <posy>10</posy>
          <width>830</width>
          <height>40</height>
          <font>BodyMedium</font>
          <textcolor>primary_blue</textcolor>
          <selectedcolor>primary_blue</selectedcolor>
          <label>$LISTITEM</label>
        </control>
      </focusedlayout>
    </control>
    
    <!-- Scrollbar -->
    <control type="scrollbar" id="13">
      <posx>900</posx>
      <posy>70</posy>
      <width>15</width>
      <height>400</height>
      <texturesliderbackground colordiffuse="surface_variant">-</texturesliderbackground>
      <texturesliderbar colordiffuse="primary_blue">-</texturesliderbar>
      <texturesliderbarfocus colordiffuse="primary_blue_focus">-</texturesliderbarfocus>
      <onup>3</onup>
      <ondown>3</ondown>
    </control>
    
    <!-- Footer -->
    <control type="group" id="200">
      <posx>30</posx>
      <posy>480</posy>
      <width>860</width>
      <height>50</height>
      
      <!-- Divider -->
      <control type="image">
        <posx>0</posx>
        <posy>0</posy>
        <width>860</width>
        <height>1</height>
        <texture colordiffuse="surface_variant">-</texture>
      </control>
      
      <!-- Info Text -->
      <control type="label" id="2">
        <posx>0</posx>
        <posy>8</posy>
        <width>860</width>
        <height>40</height>
        <font>BodySmall</font>
        <textcolor>text_secondary</textcolor>
        <label></label>
      </control>
    </control>
  </control>
</window>
