<?xml version="1.0" encoding="UTF-8"?>
<window type="home" id="0">
  <!-- Background -->
  <backgroundcolor>background_dark</backgroundcolor>
  
  <!-- Top Navigation Bar -->
  <control type="group" id="100">
    <posx>0</posx>
    <posy>0</posy>
    <width>1280</width>
    <height>60</height>
    
    <!-- Navigation Background -->
    <control type="image">
      <description>Top bar background</description>
      <posx>0</posx>
      <posy>0</posy>
      <width>1280</width>
      <height>60</height>
      <texture colordiffuse="surface">-</texture>
    </control>
    
    <!-- Kodi Logo/Branding -->
    <control type="label">
      <description>App Title</description>
      <posx>30</posx>
      <posy>12</posy>
      <width>400</width>
      <height>36</height>
      <font>TitleLarge</font>
      <textcolor>text_primary</textcolor>
      <label>Kodi</label>
    </control>
  </control>
  
  <!-- Featured Content Section -->
  <control type="group" id="200">
    <posx>0</posx>
    <posy>60</posy>
    <width>1280</width>
    <height>350</height>
    
    <!-- Featured Item Background -->
    <control type="image">
      <description>Featured content background</description>
      <posx>0</posx>
      <posy>0</posy>
      <width>1280</width>
      <height>350</height>
      <texture colordiffuse="background_darker">-</texture>
    </control>
    
    <!-- Featured Image -->
    <control type="image">
      <description>Featured image</description>
      <posx>30</posx>
      <posy>30</posy>
      <width>500</width>
      <height>290</height>
      <texture border="8">$INFO[Skin.String(FeaturedImage)]</texture>
      <aspectratio align="center" aligny="center">keep</aspectratio>
    </control>
    
    <!-- Featured Title -->
    <control type="label">
      <description>Featured title</description>
      <posx>550</posx>
      <posy>50</posy>
      <width>680</width>
      <height>60</height>
      <font>HeadlineMedium</font>
      <textcolor>text_primary</textcolor>
      <label>Featured Content</label>
      <wrapmultiline>true</wrapmultiline>
    </control>
    
    <!-- Featured Description -->
    <control type="textbox">
      <description>Featured description</description>
      <posx>550</posx>
      <posy>120</posy>
      <width>680</width>
      <height>100</height>
      <font>BodySmall</font>
      <textcolor>text_secondary</textcolor>
      <text>Welcome to your Kodi media center with a clean interface.</text>
    </control>
  </control>
  
  <!-- Content Grid Section -->
  <control type="group" id="300">
    <posx>0</posx>
    <posy>430</posy>
    <width>1280</width>
    <height>240</height>
    
    <!-- Section Title -->
    <control type="label">
      <description>Recently Watched</description>
      <posx>30</posx>
      <posy>0</posy>
      <width>400</width>
      <height>30</height>
      <font>TitleMedium</font>
      <textcolor>text_primary</textcolor>
      <label>Recently Watched</label>
    </control>
    
    <!-- Divider Line -->
    <control type="image">
      <description>Section divider</description>
      <posx>30</posx>
      <posy>35</posy>
      <width>1220</width>
      <height>1</height>
      <texture colordiffuse="surface_variant">-</texture>
    </control>
    
    <!-- Content Cards (3 items) -->
    <control type="button" id="301">
      <description>Content card 1</description>
      <posx>30</posx>
      <posy>50</posy>
      <width>220</width>
      <height>160</height>
      <label></label>
      <texturepath border="3" colordiffuse="surface_variant">-</texturepath>
    </control>
    
    <control type="button" id="302">
      <description>Content card 2</description>
      <posx>280</posx>
      <posy>50</posy>
      <width>220</width>
      <height>160</height>
      <label></label>
      <texturepath border="3" colordiffuse="surface_variant">-</texturepath>
    </control>
    
    <control type="button" id="303">
      <description>Content card 3</description>
      <posx>530</posx>
      <posy>50</posy>
      <width>220</width>
      <height>160</height>
      <label></label>
      <texturepath border="3" colordiffuse="surface_variant">-</texturepath>
    </control>
    
    <control type="button" id="304">
      <description>Content card 4</description>
      <posx>780</posx>
      <posy>50</posy>
      <width>220</width>
      <height>160</height>
      <label></label>
      <texturepath border="3" colordiffuse="surface_variant">-</texturepath>
    </control>
    
    <control type="button" id="305">
      <description>Content card 5</description>
      <posx>1030</posx>
      <posy>50</posy>
      <width>220</width>
      <height>160</height>
      <label></label>
      <texturepath border="3" colordiffuse="surface_variant">-</texturepath>
    </control>
  </control>
  
  <!-- Bottom Status Bar -->
  <control type="group" id="900">
    <posx>0</posx>
    <posy>660</posy>
    <width>1280</width>
    <height>60</height>
    
    <!-- Status bar background -->
    <control type="image">
      <description>Bottom bar background</description>
      <posx>0</posx>
      <posy>0</posy>
      <width>1280</width>
      <height>60</height>
      <texture colordiffuse="surface">-</texture>
    </control>
    
    <!-- Clock -->
    <control type="label">
      <description>Time display</description>
      <posx>30</posx>
      <posy>15</posy>
      <width>200</width>
      <height>30</height>
      <font>time</font>
      <textcolor>text_secondary</textcolor>
      <label>$INFO[System.Time]</label>
    </control>
  </control>
</window>
