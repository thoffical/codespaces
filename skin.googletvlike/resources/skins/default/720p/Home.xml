<?xml version="1.0" encoding="UTF-8"?>
<!-- GoogleTV Like Skin - Home Screen (1280x720) - 720p Scaled Version -->
<window id="0">
  <defaultcontrol always="true">300</defaultcontrol>
  <allowoverlay>yes</allowoverlay>

  <!-- Background -->
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1280</width>
    <height>720</height>
    <texture>$VAR[color_background]</texture>
  </control>

  <!-- Top Navigation Bar -->
  <control type="group" id="100">
    <left>0</left>
    <top>0</top>
    <width>1280</width>
    <height>60</height>

    <!-- Nav Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1280</width>
      <height>60</height>
      <texture>$VAR[color_surface]</texture>
    </control>

    <!-- Title -->
    <control type="label">
      <left>20</left>
      <top>10</top>
      <width>400</width>
      <height>40</height>
      <font>HeadlineMedium</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>GoogleTV Like</label>
    </control>
  </control>

  <!-- Featured Content Section -->
  <control type="group" id="200">
    <left>20</left>
    <top>70</top>
    <width>1240</width>
    <height>250</height>

    <!-- Featured Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1240</width>
      <height>250</height>
      <texture>$VAR[color_surface_variant]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Featured Title -->
    <control type="label">
      <left>20</left>
      <top>15</top>
      <width>700</width>
      <height>40</height>
      <font>HeadlineSmall</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>Featured</label>
    </control>

    <!-- Featured Description -->
    <control type="textbox">
      <left>20</left>
      <top>60</top>
      <width>900</width>
      <height>170</height>
      <font>BodyMedium</font>
      <textcolor>$VAR[color_text_secondary]</textcolor>
      <text>Welcome to GoogleTV Like</text>
    </control>
  </control>

  <!-- Content Grid -->
  <control type="group" id="300">
    <left>20</left>
    <top>340</top>
    <width>1240</width>
    <height>330</height>

    <!-- Grid Title -->
    <control type="label">
      <left>0</left>
      <top>0</top>
      <width>700</width>
      <height>40</height>
      <font>HeadlineMedium</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>Browse</label>
    </control>

    <!-- Card 1 -->
    <control type="image">
      <left>0</left>
      <top>50</top>
      <width>220</width>
      <height>270</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 2 -->
    <control type="image">
      <left>240</left>
      <top>50</top>
      <width>220</width>
      <height>270</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 3 -->
    <control type="image">
      <left>480</left>
      <top>50</top>
      <width>220</width>
      <height>270</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 4 -->
    <control type="image">
      <left>720</left>
      <top>50</top>
      <width>220</width>
      <height>270</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 5 -->
    <control type="image">
      <left>960</left>
      <top>50</top>
      <width>220</width>
      <height>270</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>
  </control>

  <!-- Bottom Status Bar -->
  <control type="group" id="900">
    <left>0</left>
    <top>660</top>
    <width>1280</width>
    <height>60</height>

    <!-- Status Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1280</width>
      <height>60</height>
      <texture>$VAR[color_surface]</texture>
    </control>

    <!-- Status Text -->
    <control type="label">
      <left>20</left>
      <top>15</top>
      <width>400</width>
      <height>30</height>
      <font>LabelMedium</font>
      <textcolor>$VAR[color_text_secondary]</textcolor>
      <label>Ready</label>
    </control>
  </control>
</window>