<?xml version="1.0" encoding="UTF-8"?>
<!-- GoogleTV Like Skin - Home Screen (1920x1080) -->
<window id="0">
  <defaultcontrol always="true">300</defaultcontrol>
  <allowoverlay>yes</allowoverlay>

  <!-- Background -->
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1920</width>
    <height>1080</height>
    <texture>$VAR[color_background]</texture>
  </control>

  <!-- Top Navigation Bar -->
  <control type="group" id="100">
    <left>0</left>
    <top>0</top>
    <width>1920</width>
    <height>80</height>

    <!-- Nav Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>80</height>
      <texture>$VAR[color_surface]</texture>
    </control>

    <!-- Title -->
    <control type="label">
      <left>40</left>
      <top>20</top>
      <width>500</width>
      <height>40</height>
      <font>HeadlineLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>GoogleTV Like</label>
    </control>
  </control>

  <!-- Featured Content Section -->
  <control type="group" id="200">
    <left>40</left>
    <top>100</top>
    <width>1840</width>
    <height>350</height>

    <!-- Featured Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1840</width>
      <height>350</height>
      <texture>$VAR[color_surface_variant]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Featured Title -->
    <control type="label">
      <left>30</left>
      <top>20</top>
      <width>1000</width>
      <height>50</height>
      <font>DisplaySmall</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>Featured</label>
    </control>

    <!-- Featured Description -->
    <control type="textbox">
      <left>30</left>
      <top>80</top>
      <width>1400</width>
      <height>240</height>
      <font>BodyLarge</font>
      <textcolor>$VAR[color_text_secondary]</textcolor>
      <text>Welcome to GoogleTV Like - A modern, clean Kodi skin inspired by Google TV</text>
    </control>
  </control>

  <!-- Content Grid -->
  <control type="group" id="300">
    <left>40</left>
    <top>480</top>
    <width>1840</width>
    <height>540</height>

    <!-- Grid Title -->
    <control type="label">
      <left>0</left>
      <top>0</top>
      <width>1000</width>
      <height>50</height>
      <font>HeadlineLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <label>Browse Content</label>
    </control>

    <!-- Card 1 -->
    <control type="image">
      <left>0</left>
      <top>60</top>
      <width>350</width>
      <height>450</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 2 -->
    <control type="image">
      <left>370</left>
      <top>60</top>
      <width>350</width>
      <height>450</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 3 -->
    <control type="image">
      <left>740</left>
      <top>60</top>
      <width>350</width>
      <height>450</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 4 -->
    <control type="image">
      <left>1110</left>
      <top>60</top>
      <width>350</width>
      <height>450</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>

    <!-- Card 5 -->
    <control type="image">
      <left>1480</left>
      <top>60</top>
      <width>350</width>
      <height>450</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>1</bordersize>
      <bordercolor>$VAR[color_border]</bordercolor>
    </control>
  </control>

  <!-- Bottom Status Bar -->
  <control type="group" id="900">
    <left>0</left>
    <top>1000</top>
    <width>1920</width>
    <height>80</height>

    <!-- Status Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>1920</width>
      <height>80</height>
      <texture>$VAR[color_surface]</texture>
    </control>

    <!-- Status Text -->
    <control type="label">
      <left>40</left>
      <top>20</top>
      <width>500</width>
      <height>40</height>
      <font>LabelLarge</font>
      <textcolor>$VAR[color_text_secondary]</textcolor>
      <label>Ready</label>
    </control>
  </control>
</window>