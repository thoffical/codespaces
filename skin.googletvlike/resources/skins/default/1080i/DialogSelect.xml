<?xml version="1.0" encoding="UTF-8"?>
<!-- GoogleTV Like Skin - Select Dialog (1920x1080) -->
<window id="3">
  <defaultcontrol always="true">3</defaultcontrol>
  <allowoverlay>yes</allowoverlay>

  <!-- Overlay Background -->
  <control type="image">
    <left>0</left>
    <top>0</top>
    <width>1920</width>
    <height>1080</height>
    <texture>$VAR[color_overlay_dark]</texture>
  </control>

  <!-- Dialog Container -->
  <control type="group">
    <left>480</left>
    <top>200</top>
    <width>960</width>
    <height>680</height>

    <!-- Dialog Background -->
    <control type="image">
      <left>0</left>
      <top>0</top>
      <width>960</width>
      <height>680</height>
      <texture>$VAR[color_surface]</texture>
      <bordersize>2</bordersize>
      <bordercolor>$VAR[color_primary]</bordercolor>
    </control>

    <!-- Title -->
    <control type="label" id="1">
      <left>30</left>
      <top>30</top>
      <width>900</width>
      <height>50</height>
      <font>HeadlineLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
    </control>

    <!-- List Control -->
    <control type="list" id="3">
      <left>30</left>
      <top>90</top>
      <width>900</width>
      <height>520</height>
      <onleft>610</onleft>
      <onright>610</onright>
      <onup>3</onup>
      <ondown>3</ondown>
      <itemlayout height="50">
        <control type="label">
          <left>20</left>
          <top>0</top>
          <width>860</width>
          <height>50</height>
          <font>BodyLarge</font>
          <textcolor>$VAR[color_text_primary]</textcolor>
          <selectedcolor>$VAR[color_primary]</selectedcolor>
          <info>ListItem.Label</info>
        </control>
      </itemlayout>
      <focusedlayout height="50">
        <control type="image">
          <left>0</left>
          <top>0</top>
          <width>900</width>
          <height>50</height>
          <texture>$VAR[color_primary]</texture>
        </control>
        <control type="label">
          <left>20</left>
          <top>0</top>
          <width>860</width>
          <height>50</height>
          <font>BodyLarge</font>
          <textcolor>$VAR[color_text_primary]</textcolor>
          <info>ListItem.Label</info>
        </control>
      </focusedlayout>
    </control>

    <!-- Buttons -->
    <control type="button" id="10">
      <left>30</left>
      <top>620</top>
      <width>430</width>
      <height>40</height>
      <label>OK</label>
      <font>LabelLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <focusedcolor>$VAR[color_primary]</focusedcolor>
      <onclick>Dialog.Close(select)</onclick>
    </control>

    <control type="button" id="11">
      <left>500</left>
      <top>620</top>
      <width>430</width>
      <height>40</height>
      <label>Cancel</label>
      <font>LabelLarge</font>
      <textcolor>$VAR[color_text_primary]</textcolor>
      <focusedcolor>$VAR[color_primary]</focusedcolor>
      <onclick>Dialog.Close(select)</onclick>
    </control>
  </control>
</window>