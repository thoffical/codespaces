<?xml version="1.0" encoding="UTF-8"?>
<window type="dialog" id="101">
  <!-- Progress Dialog - For operations like scanning, loading, etc. -->
  
  <backgroundcolor>background_dark</backgroundcolor>
  
  <!-- Semi-transparent overlay -->
  <control type="image">
    <posx>0</posx>
    <posy>0</posy>
    <width>1920</width>
    <height>1080</height>
    <texture colordiffuse="overlay_dark">-</texture>
  </control>
  
  <!-- Dialog Container -->
  <control type="group">
    <posx>400</posx>
    <posy>450</posy>
    <width>1120</width>
    <height>180</height>
    
    <!-- Background -->
    <control type="image">
      <posx>0</posx>
      <posy>0</posy>
      <width>1120</width>
      <height>180</height>
      <texture colordiffuse="surface">-</texture>
      <bordertexture border="20">-</bordertexture>
    </control>
    
    <!-- Title -->
    <control type="label" id="1">
      <posx>40</posx>
      <posy>20</posy>
      <width>1040</width>
      <height>50</height>
      <font>HeadlineSmall</font>
      <textcolor>text_primary</textcolor>
      <label></label>
    </control>
    
    <!-- Progress Bar -->
    <control type="progress" id="20">
      <posx>40</posx>
      <posy>80</posy>
      <width>1040</width>
      <height>6</height>
      <texturebg colordiffuse="surface_variant">-</texturebg>
      <textureleft colordiffuse="primary_blue">-</textureleft>
      <texturemid colordiffuse="primary_blue">-</texturemid>
      <textureright colordiffuse="primary_blue">-</textureright>
    </control>
    
    <!-- Progress Text -->
    <control type="label" id="30">
      <posx>40</posx>
      <posy>100</posy>
      <width>1040</width>
      <height>60</height>
      <font>BodyMedium</font>
      <textcolor>text_secondary</textcolor>
      <label></label>
      <wrapmultiline>true</wrapmultiline>
    </control>
  </control>
</window>
